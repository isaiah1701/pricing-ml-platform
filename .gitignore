# Terraform working directories and state contain machine-local data or secrets.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Python-generated local environments and caches.
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
*.py[cod]

# Feast-generated local registry state.
feature_repo/data/

# Content-addressed datasets are runtime artifacts retained outside Git.
data/snapshots/

# MLflow's local tracking database and model artifacts.
mlflow.db
mlflow-data/
mlruns/

# Keep shared environment inputs in the committed *.tfvars files. Put real IAM
# principal ARNs and other local values in one of these ignored files instead.
*.auto.tfvars
*.local.tfvars
