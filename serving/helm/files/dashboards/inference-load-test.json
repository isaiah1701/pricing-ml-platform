{
  "title": "Inference Load Test",
  "uid": "airbnb-inference-load-test",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "graphTooltip": 1,
  "tags": ["airbnb", "mlops", "load-test"],
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "Prediction throughput",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum(rate(airbnb_http_requests_total{namespace=\"airbnb-inference\",endpoint=\"/predict\"}[1m]))", "legendFormat": "requests/sec", "format": "time_series"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "Awaiting traffic"}, "overrides": []}
    },
    {
      "id": 2,
      "title": "Prediction latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(airbnb_prediction_latency_seconds_bucket{namespace=\"airbnb-inference\"}[1m])))", "legendFormat": "p50", "format": "time_series"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(airbnb_prediction_latency_seconds_bucket{namespace=\"airbnb-inference\"}[1m])))", "legendFormat": "p95", "format": "time_series"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(airbnb_prediction_latency_seconds_bucket{namespace=\"airbnb-inference\"}[1m])))", "legendFormat": "p99", "format": "time_series"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "Awaiting predictions"}, "overrides": []}
    },
    {
      "id": 3,
      "title": "Prediction error rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum(rate(airbnb_http_requests_total{namespace=\"airbnb-inference\",endpoint=\"/predict\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(airbnb_http_requests_total{namespace=\"airbnb-inference\",endpoint=\"/predict\"}[1m])), 0.001)", "legendFormat": "5xx error rate", "format": "time_series"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "noValue": "Awaiting traffic"}, "overrides": []}
    },
    {
      "id": 4,
      "title": "Ready replicas",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "sum(max by (pod) (airbnb_readiness{namespace=\"airbnb-inference\"}))", "legendFormat": "ready replicas", "format": "time_series"},
        {"refId": "B", "expr": "max(kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"airbnb-inference\",horizontalpodautoscaler=\"keda-hpa-airbnb-inference\"})", "legendFormat": "desired replicas", "format": "time_series"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "noValue": "Awaiting metrics"}, "overrides": []}
    },
    {
      "id": 5,
      "title": "Inference CPU by pod",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"airbnb-inference\",container=\"inference\"}[1m]))", "legendFormat": "{{pod}}", "format": "time_series"}],
      "fieldConfig": {"defaults": {"unit": "cores", "noValue": "Awaiting metrics"}, "overrides": []}
    },
    {
      "id": 6,
      "title": "Inference memory by pod",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"airbnb-inference\",container=\"inference\"})", "legendFormat": "{{pod}}", "format": "time_series"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "noValue": "Awaiting metrics"}, "overrides": []}
    },
    {
      "id": 7,
      "title": "Pending inference pods",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum(kube_pod_status_phase{namespace=\"airbnb-inference\",phase=\"Pending\"})", "legendFormat": "pending pods", "format": "time_series"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "noValue": "No pending pods"}, "overrides": []}
    },
    {
      "id": 8,
      "title": "Node CPU utilisation",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))", "legendFormat": "{{instance}}", "format": "time_series"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "noValue": "Awaiting metrics"}, "overrides": []}
    }
  ]
}
